# Diese Variablen im Netlify-Projekt unter Site configuration → Environment variables setzen.
# Ohne SMTP-Daten kann das Kontaktformular nicht senden, ohne API-Key bleibt der KI-Chat ausgeblendet.

# --- Recipient for contact form & sales leads ---
MAIL_TO=michael@wagner-consult.net
MAIL_FROM=no-reply@wagner-consult.net

# --- SMTP credentials (e.g. Gmail, Office365, your hosting provider) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# --- Anthropic API key for the AI sales chatbot ---
ANTHROPIC_API_KEY=sk-ant-...

